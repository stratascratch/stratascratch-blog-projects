-- Creates and populates the users table used in the
-- Recursive CTE "Referral Chains" use case.
--
-- Edge cases baked in:
--   alice, frank, and grace all have referred_by = NULL -> three
--   independent trees (a forest), not a single tree
--   alice's chain runs 5 levels deep: alice -> bob -> dave -> finn -> gwen
--   harry has referred_by = 12, his own user_id -> a genuine infinite
--   loop under a "network size for every user" query, unlike the
--   unreachable-island self-reference in Employee Hierarchy
--   grace, carol, erin, gwen, irene, and jack all have zero referrals

DROP TABLE IF EXISTS users;

CREATE TABLE users (
    user_id       INT PRIMARY KEY,
    user_name     VARCHAR(50),
    referred_by   INT,
    signup_date   DATE
);

