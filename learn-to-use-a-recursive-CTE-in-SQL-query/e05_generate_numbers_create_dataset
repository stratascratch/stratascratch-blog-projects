-- Creates and populates the orders table used in the
-- Recursive CTE "Generate Numbers" use case.
--
-- Edge cases baked in:
--   1003 is a single missing ID surrounded by real orders on both sides
--   1007-1008 and 1011-1012 are two separate multi-ID gaps
--   1015 is another single missing ID
--   1019 is missing immediately before the maximum ID (1020) -> edge-of-range gap
--   1001 and 1020, the true min/max, both exist -> range boundaries must be
--   derived from MIN()/MAX() on real data, not assumed in advance
 
DROP TABLE IF EXISTS orders;
 
CREATE TABLE orders (
    order_id       INT PRIMARY KEY,
    customer_name  VARCHAR(50),
    order_date     DATE
);
 
