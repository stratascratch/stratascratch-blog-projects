-- Creates and populates the items table used in the
-- Recursive CTE "Folder Structure Traversal" use case.
--
-- Edge cases baked in:
--   photo2.jpg has size_kb = NULL   -> unknown size (corrupted metadata),
--                                       silently excluded by SUM()
--   backup.zip has size_kb = 0      -> a real, legitimately empty file,
--                                       distinct from the NULL case above
--   'Empty' folder has zero children of any kind
--   'Archive' has no direct files, only a nested subfolder ('Old')
--   files and folders share one table and one parent_id column

DROP TABLE IF EXISTS items;

CREATE TABLE items (
    item_id    INT PRIMARY KEY,
    item_name  VARCHAR(50),
    item_type  VARCHAR(10),
    parent_id  INT,
    size_kb    INT
);

