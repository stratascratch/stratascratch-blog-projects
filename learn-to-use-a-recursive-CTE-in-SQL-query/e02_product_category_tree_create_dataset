-- Creates and populates the product_categories table used in the
-- Recursive CTE "Product Category Tree" use case.
--
-- Edge cases baked in:
--   category_id 1, 2, 3 all have parent_category_id = NULL -> a forest of
--   three roots (Electronics, Clothing, Home Goods), not a single tree
--
--   category_id 11 ('Smart Watches') and 12 ('Fitness Trackers') point at
--   EACH OTHER as parent instead of both pointing to their real parent,
--   'Wearables' (6) -> a genuine two-node cycle
 
DROP TABLE IF EXISTS product_categories;
 
CREATE TABLE product_categories (
    category_id         INT PRIMARY KEY,
    category_name       VARCHAR(50),
    parent_category_id  INT
);
 
