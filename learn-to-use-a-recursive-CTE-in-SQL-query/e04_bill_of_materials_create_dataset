-- Creates and populates the components table used in the
-- Recursive CTE "Bill of Materials (BOM)" use case.
--
-- Edge cases baked in:
--   Spoke needs 32 units per wheel, and the bicycle needs 2 wheels ->
--   nothing in the table says '64 spokes total'; that only exists if you
--   correctly multiply quantities down through every level
--
--   Two rows are both named 'Bolt' (component_id 5, under Frame at qty 4;
--   component_id 9, under Wheel at qty 1) -> the same real-world part,
--   cataloged separately per subassembly. Getting the true total requires
--   aggregating by component_name, not component_id
--
--   Reflector has quantity_per_parent = 0 -> a deprecated accessory still
--   listed in the master BOM. It has its own child (Reflector Bracket), so
--   filtering out zero-quantity rows too early would prevent the recursion
--   from ever discovering Reflector Bracket
 
DROP TABLE IF EXISTS components;
 
CREATE TABLE components (
    component_id          INT PRIMARY KEY,
    component_name        VARCHAR(50),
    parent_component_id   INT,
    quantity_per_parent   INT
);
 
