-- Creates and populates the employees table used in the
-- Recursive CTE "Employee Hierarchy" use case.
--
-- Edge cases baked in:
--   employee_id 1  (CEO) has a NULL manager_id      -> required anchor point
--   employee_id 9  lists manager_id = 9 (self-ref)  -> tests cycle guards
--   employee_id 14 has manager_id = 99, nonexistent -> orphaned row
--   employee_id 6 and 12 share the name 'sarah kim' in different depts
--   employee_id 8's name has trailing whitespace ('mike torres ')

DROP TABLE IF EXISTS employees;

CREATE TABLE employees (
    employee_id   INT PRIMARY KEY,
    employee_name VARCHAR(50),
    manager_id    INT,
    department    VARCHAR(50),
    title         VARCHAR(50),
    hire_date     DATE
);

